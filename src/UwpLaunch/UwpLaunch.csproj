<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>uwplaunch</AssemblyName>
    <RootNamespace>UwpLaunch</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The registered debugger command line is truncated by the system somewhere around 255
         characters, and it has to hold this exe's full path plus its arguments. Keep the
         output path short and the assembly name shorter. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
