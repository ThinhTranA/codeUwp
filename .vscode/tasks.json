{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile extension",
            "type": "process",
            // A process task, not a shell one: no quoting layer to get wrong, and the exit
            // code is the script's own.
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/tools/Compile-Extension.ps1"
            ],
            "problemMatcher": "$tsc",
            "group": "build",
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
