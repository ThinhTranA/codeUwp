<Application
    x:Class="ClassicUwpWinUI2.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassicUwpWinUI2">

    <Application.Resources>
        <!-- WinUI 2. Everything below hangs off this, and it is also the thing a
             ReplaceResource-based hot reload would swap. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <x:Double x:Key="CardCornerRadius">8</x:Double>
            <SolidColorBrush x:Key="AccentFill" Color="#0078D4" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
