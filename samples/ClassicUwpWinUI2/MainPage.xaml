<Page
    x:Class="ClassicUwpWinUI2.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassicUwpWinUI2"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      Deliberately built to exercise the hot-reload paths that matter:
        - x:Name'd elements (the easy case a tap can address directly)
        - unnamed elements (must be reachable by tree position, not by name)
        - x:Bind (compiled binding: the thing XamlReader.Load cannot handle)
        - a click handler (the other thing XamlReader.Load cannot handle)
        - app-level resources (the ReplaceResource path)
        - a WinUI 2 control, to prove the muxc namespace resolves
    -->
    <Grid Padding="32" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Title"
            Grid.Row="0"
            Text="UWP Tools for VS Code tests some !!!ee"
            FontSize="32"
            FontWeight="SemiBold"
            Foreground="{StaticResource AccentFill}" />

        <!-- Unnamed on purpose: a hot-reload edit here has to be located structurally. -->
        <TextBlock
            Grid.Row="1"
            Text="Edit this file, save, and the running app should change without restarting."
            TextWrapping="Wrap"
            Opacity="0.7" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <Button x:Name="CounterButton" Click="OnCounterClick" Content="Click me" />
            <TextBlock
                x:Name="CounterText"
                VerticalAlignment="Center"
                Text="{x:Bind ClickCountText, Mode=OneWay}" />
        </StackPanel>

        <muxc:InfoBar
            Grid.Row="3"
            VerticalAlignment="Top"
            IsOpen="True"
            IsClosable="False"
            Severity="Informational"
            Title="WinUI 2"
            Message="This InfoBar comes from Microsoft.UI.Xaml, so the package restored and the muxc namespace resolved." />
    </Grid>
</Page>
