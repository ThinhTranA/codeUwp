    <EnableDotNetNativeCompatibleProfile>true</EnableDotNetNativeCompatibleProfile>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <!-- Loose-file deployment only: no packaging, no signing, in the inner loop. -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <!-- Required for XAML Hot Reload: keeps XBF line info so a live element can be traced
         back to the markup line that set it. -->
    <DisableXbfLineInfo>False</DisableXbfLineInfo>
    <!--
      Debug configurations use DebugType=portable, not the UWP template's default of "full".

      "full" emits a Windows PDB, and the cross-platform .NET debugger (vsdbg, shipped in both
      the C# extension and ReSharper) cannot read those. It attaches, loads every module, and
      then silently binds no breakpoints. The only sign is one line buried in the debug
      console, saying the pdb is a Windows PDB and is not supported by the cross-platform
      debugger, which is easy to mistake for the AppContainer refusing to be debugged.
    -->
  </PropertyGroup>

